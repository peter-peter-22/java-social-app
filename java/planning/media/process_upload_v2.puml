@startuml

title Processing a signed image upload behind the upload API

skinparam BoxPadding 5
skinparam ParticipantPadding 5

actor Client

box Upload service
    participant UploadApi
    participant ImageProcessor
    database MediaDB
    database ObjectStorage
    queue MQ
endbox

participant MainApp



Client->UploadApi: POST /upload/image
note right: upload parameters + signature + file

activate UploadApi

    UploadApi->UploadApi: verify signature and constraints
    UploadApi->ObjectStorage: upload temporary staging object
    UploadApi->MediaDB: register the upload with pending status
    opt if eager transformations are requested
        UploadApi->MediaDB: register the requested transformations with pending status
    end
    UploadApi->MediaDB: transformation names
    MediaDB-->UploadApi: transformation parameters


    alt async processing
        UploadApi->MQ: queue the processing
    else blocking processing
        UploadApi->ImageProcessor: POST /transform
        activate ImageProcessor
            ImageProcessor->ObjectStorage: get the staging object
            ObjectStorage-->ImageProcessor: the original file
            ImageProcessor->ImageProcessor: get image metadata

            opt if incoming transformation is requested
                ImageProcessor->ImageProcessor: process the incoming transformation, overwrite the original file
            end

            opt if eager transformation is requested
                ImageProcessor->ImageProcessor: process the transformation
                ImageProcessor->ObjectStorage: save the transformed variants
                ImageProcessor->MediaDB: update the status of the variants
            end

            opt if webhook requested
                ImageProcessor -> MainApp: POST transformation-complete webhook
            end
        deactivate ImageProcessor
    end
deactivate UploadApi


== Async processing ==

MQ -> ImageProcessor: ProcessingJob(uploadId, transformations)

activate ImageProcessor

ImageProcessor -> MediaDB: Claim job

alt job already processed
    ImageProcessor -> ImageProcessor: Ignore duplicate
else processing required
    ImageProcessor -> ObjectStorage: Read original
    ImageProcessor -> ImageProcessor: Process transformations
    ImageProcessor -> ObjectStorage: Save variants
    ImageProcessor -> MediaDB: Register variants
    ImageProcessor -> MediaDB: Mark READY

    opt webhook
        ImageProcessor -> MainApp: POST transformation-complete webhook
    end
end

deactivate ImageProcessor

@enduml